# ── Google OAuth (npm run setup:google 로 얻습니다) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# 사진이 저장될 드라이브 루트 폴더 ID (setup 스크립트가 만들어 줍니다)
DRIVE_ROOT_FOLDER_ID=

# ── 접근 제어 ──
# 관리자 계정: 보기 + 업로드·수정·삭제·이동·앨범 관리
SITE_ID=
SITE_PASSWORD=
# 보기 전용 계정: 사진 보기 + 정원pick!(좋아요)만 (비워 두면 꺼짐)
USER_ID=
USER_PASSWORD=
# 쿠키 서명용 임의 문자열
# 생성: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
COOKIE_SECRET=

# 접속 기록(/logs) 보기 비밀번호 (관리자 본인만)
ADMIN_PASSWORD=
