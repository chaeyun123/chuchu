# ── Google OAuth (npm run setup:google 로 얻습니다) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# 사진이 저장될 드라이브 루트 폴더 ID (setup 스크립트가 만들어 줍니다)
DRIVE_ROOT_FOLDER_ID=

# ── 접근 제어 ──
# 공유 링크용 비밀 토큰: https://내사이트/s/<SITE_TOKEN>
# 생성: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
SITE_TOKEN=
# 업로드 페이지 비밀번호 (업로드할 사람에게만 알려주세요)
UPLOAD_PASSWORD=
# 쿠키 서명용 임의 문자열 (위와 같은 방법으로 생성)
COOKIE_SECRET=
